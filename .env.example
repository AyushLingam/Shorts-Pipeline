# ---- Vizard.ai ----
VIZARD_API_KEY=your_vizard_api_key_here

# Leave blank to use Vizard's default model. Set to "v1" or "v2" to force
# one (matches the "Select model" picker in the Vizard web app).
VIZARD_CLIP_MODEL=
# Ask Vizard for as many clips as it'll give (1-100) -- we upload all of them.
VIZARD_MAX_CLIP_NUMBER=100

# Optional: clip styling. Leave VIZARD_TEMPLATE_ID blank to use Vizard's
# default look. To make a template: Vizard web app -> Edit a clip ->
# Template tab -> design it -> copy its ID.
VIZARD_TEMPLATE_ID=
VIZARD_RATIO_OF_CLIP=1
VIZARD_SUBTITLE_SWITCH=1
VIZARD_HEADLINE_SWITCH=1
VIZARD_EMOJI_SWITCH=0
VIZARD_HIGHLIGHT_SWITCH=0
VIZARD_REMOVE_SILENCE=0

# ---- YouTube ----
# Paths to files produced by the OAuth flow (scripts/first_time_youtube_auth.py)
YT_CLIENT_SECRET_FILE=./client_secret.json
YT_TOKEN_FILE=./token.json

# Your channel to watch (youtube.com/account_advanced -> Channel ID, starts with UC)
SOURCE_CHANNEL_ID=
# How many of the channel's most recent uploads to scan when picking the
# highest-viewed unprocessed one (not just the newest).
CHANNEL_SCAN_LIMIT=50

# Default Google Cloud project quota is 10,000 units/day; an upload costs
# 1,600 -- so ~6 uploads/day unless you've requested a quota increase.
# scripts/drain_upload_queue.py will only upload this many per run.
YOUTUBE_DAILY_UPLOAD_QUOTA=6

# ---- Scheduling (scripts/fetch_and_queue.py + scheduler.py) ----
# "scheduled" = private upload with YouTube's publishAt set (auto-publishes
# at its slot unless you intervene first). "private" = never auto-publish.
UPLOAD_MODE=scheduled
SCHEDULE_TARGET_GAP_HOURS=4
SCHEDULE_MAX_GAP_HOURS=5
SCHEDULE_TIGHT_GAP_HOURS=3
SCHEDULE_DAY_START_HOUR=8
SCHEDULE_DAY_END_HOUR=23
SCHEDULE_PEAK_START_HOUR=12
SCHEDULE_PEAK_END_HOUR=20
SCHEDULE_TARGET_DAYS=3
SCHEDULE_TIMEZONE=America/New_York

# Where downloaded clips wait between being queued and actually uploaded.
QUEUE_DIR=./queued_clips

# ---- Pipeline behavior ----
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=90
DB_PATH=./shorts.db
